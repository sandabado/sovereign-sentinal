# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Plaid
PLAID_CLIENT_ID=your-client-id
PLAID_SECRET=your-secret-key
PLAID_ENV=sandbox
NEXT_PUBLIC_PLAID_ENV=sandbox
# Base64-encoded 32-byte key used to encrypt Plaid access tokens at rest.
# Generate once with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
# Local sandbox testing only; never set true in production.
PLAID_SKIP_WEBHOOK_VERIFICATION=false

# OpenAI (optional for V1)
OPENAI_API_KEY=your-openai-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
